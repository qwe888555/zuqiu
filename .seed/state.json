  "contents": {
    "news": {
      "id": "cnt_5e995cb1526f433bbaf0",
      "contentType": "NEWS",
      "title": "2026年四川省青少年校园足球联赛报名启动",
      "summary": "全省中小学与高校球队即日起可通过平台完成赛事报名。",
      "bodyHtml": "<p>2026年四川省青少年校园足球联赛报名工作正式启动。请各参赛学校在规定时间内完成球队注册、运动员名单填报与材料上传。</p><p>报名截止时间为 2026 年 12 月 31 日，逾期不再受理。</p>",
      "coverFileId": "",
      "eventId": "evt_aa0f24635584488ea831",
      "groupId": "",
      "policyDocumentNo": "",
      "pinned": true,
      "status": "PUBLISHED",
      "revision": 1,
      "bodyText": "2026年四川省青少年校园足球联赛报名工作正式启动。请各参赛学校在规定时间内完成球队注册、运动员名单填报与材料上传。报名截止时间为 2026 年 12 月 31 日，逾期不再受理。",
      "version": 1,
      "createdAt": "2026-10-27T02:32:34.092Z",
      "updatedAt": "2026-10-27T02:32:41.584Z",
      "policyEffectiveFrom": null,
      "policyEffectiveTo": null,
      "publishedAt": "2026-10-27T02:32:41.584Z"
    },
    "policy": {
      "id": "cnt_84f44b6eaa6b44478d98",
      "contentType": "POLICY",
      "title": "四川省青少年校园足球竞赛管理办法（2026年修订）",
      "summary": "明确参赛资格、赛风赛纪与申诉流程。",
      "bodyHtml": "<p>为规范全省青少年校园足球竞赛组织工作，现将《四川省青少年校园足球竞赛管理办法（2026年修订）》予以公布。</p><p>各参赛单位应严格遵守报名资格与赛风赛纪要求。</p>",
      "coverFileId": "",
      "eventId": "",
      "groupId": "",
      "policyDocumentNo": "川教体〔2026〕12号",
      "pinned": false,
      "status": "PUBLISHED",
      "revision": 1,
      "bodyText": "为规范全省青少年校园足球竞赛组织工作，现将《四川省青少年校园足球竞赛管理办法（2026年修订）》予以公布。各参赛单位应严格遵守报名资格与赛风赛纪要求。",
      "version": 1,
      "createdAt": "2026-10-27T02:32:50.524Z",
      "updatedAt": "2026-10-27T02:32:59.611Z",
      "policyEffectiveFrom": "2026-09-01",
      "policyEffectiveTo": "2027-08-31",
      "publishedAt": "2026-10-27T02:32:59.611Z"
    },
    "highlight": {
      "id": "cnt_7486eef090224646ae58",
      "contentType": "HIGHLIGHT",
      "title": "决赛集锦：示例第一中学 2:1 示例第二中学",
      "summary": "比赛第 67 分钟绝杀，示例第一中学夺得初中男子组冠军。",
      "bodyHtml": "<p>在 2026 年 10 月 20 日进行的初中男子组决赛中，示例第一中学以 2:1 战胜示例第二中学。</p><p>双方在雨战中奉献了精彩的攻防转换，现场观众超过 800 人。</p>",
      "coverFileId": "",
      "eventId": "evt_aa0f24635584488ea831",
      "groupId": "",
      "policyDocumentNo": "",
      "pinned": false,
      "status": "PUBLISHED",
      "revision": 1,
      "bodyText": "在 2026 年 10 月 20 日进行的初中男子组决赛中，示例第一中学以 2:1 战胜示例第二中学。双方在雨战中奉献了精彩的攻防转换，现场观众超过 800 人。",
      "version": 1,
      "createdAt": "2026-10-27T02:33:08.520Z",
      "updatedAt": "2026-10-27T02:33:17.624Z",
      "policyEffectiveFrom": null,
      "policyEffectiveTo": null,
      "publishedAt": "2026-10-27T02:33:17.623Z"
    }
  },
