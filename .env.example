# 是否启用内置 Mock 接口（默认 true）。接入真实后端时改为 false。
# 无需后端演示：npm run dev:mock（读取 .env.mock）。
VITE_USE_MOCK=true

# 后端接口前缀。使用 Mock 时无影响；接入真实后端时按部署地址调整。
VITE_API_BASE_URL=/api/v1

# 开发代理目标。成员2/3/5 主服务与成员6 独立服务分别转发，避免浏览器跨域。
# 单一后端时两个 target 指向同一地址即可。
# 真实联调地址只写在被 .gitignore 忽略的 .env.local，不要提交到本模板。
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
VITE_SELECTION_PROXY_TARGET=http://127.0.0.1:8001

# 成员6（遴选评分与报名公示）服务前缀。
# 并入主程序（默认）：/api/v1/selection，由主程序 /api 代理转发，信封 { code: "OK", ... }。
# 独立部署：改为 /api/selection，经 VITE_SELECTION_PROXY_TARGET 转发，信封 { code: 0, ... }。
VITE_SELECTION_API_BASE_URL=/api/v1/selection

# 页脚备案号。未配置时不展示，避免演示占位号进入正式环境。
VITE_ICP_NUMBER=
